      "mandatory": true,
      "proof_class": "security",
      "requested_capabilities": ["pool_partition"],
      "expected_outcome": "session-partition-prevents-reuse"
    },
    {
      "id": "pool-fingerprint-partition",
      "kind": "pool_fingerprint_partition",
      "mandatory": true,
      "proof_class": "security",
      "requested_capabilities": ["pool_partition"],
