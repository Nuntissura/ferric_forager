      "kind": "redirect_cross_origin",
      "mandatory": true,
      "proof_class": "security",
      "requested_capabilities": ["redirect_policy"],
      "expected_outcome": "cross-origin-sensitive-headers-stripped"
    },
    {
      "id": "redirect-https-downgrade",
      "kind": "redirect_downgrade",
      "mandatory": true,
      "proof_class": "security",
      "requested_capabilities": ["redirect_policy"],
