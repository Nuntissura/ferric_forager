      "proof_class": "structural",
      "requested_capabilities": ["http11", "range", "streaming", "redirect_policy", "cookie_scope", "dns_provenance", "ssrf_policy", "pool_partition", "replay", "cancellation", "metadata_bounds", "body_bounds", "decompression_bounds", "retry_bounds"],
      "expected_outcome": "standard-capabilities-supported"
    },
    {
      "id": "tls-fingerprint-blocked",
      "kind": "tls_fingerprint_blocked",
      "mandatory": true,
      "proof_class": "protocol",
      "requested_capabilities": ["tls_fingerprint"],
      "expected_outcome": "FF-TRANSPORT-E-TLS-FINGERPRINT-BLOCKED"
    },
    {
      "id": "http2-fingerprint-blocked",
      "kind": "http2_fingerprint_blocked",
      "mandatory": true,
      "proof_class": "protocol",
      "requested_capabilities": ["http2_fingerprint"],
      "expected_outcome": "FF-TRANSPORT-E-H2-FINGERPRINT-BLOCKED"
    },
    {
      "id": "http2-blocked",
      "kind": "http2_blocked",
      "mandatory": true,
      "proof_class": "protocol",
      "requested_capabilities": ["http2"],
      "expected_outcome": "FF-TRANSPORT-E-HTTP2-BLOCKED"
    },
    {
      "id": "proxy-destination-evidence-blocked",
      "kind": "proxy_blocked",
      "mandatory": true,
