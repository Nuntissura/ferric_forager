      "mandatory": true,
      "proof_class": "resource",
      "requested_capabilities": ["body_bounds"],
      "expected_outcome": "FF-TRANSPORT-E-BOUND: body_bytes observed 21 exceeds 20"
    },
    {
      "id": "response-decompression-bound",
      "kind": "decompression_bound",
      "mandatory": true,
      "proof_class": "resource",
      "requested_capabilities": ["decompression_bounds"],
      "expected_outcome": "FF-TRANSPORT-E-BOUND: decompressed_bytes observed 31 exceeds 30"
    },
