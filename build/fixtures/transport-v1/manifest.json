      "requested_capabilities": ["proxy"],
      "expected_outcome": "FF-TRANSPORT-E-PROXY-EVIDENCE-BLOCKED"
    },
    {
      "id": "compression-implementation-blocked",
      "kind": "compression_blocked",
      "mandatory": true,
      "proof_class": "resource",
      "requested_capabilities": ["compression"],
      "expected_outcome": "FF-TRANSPORT-E-COMPRESSION-BLOCKED"
    },
    {
      "id": "http11-loopback-wire",
      "kind": "http11_local",
      "mandatory": true,
      "proof_class": "runtime",
      "requested_capabilities": ["http11"],
      "expected_outcome": "http11-body-ok"
    },
    {
      "id": "range-loopback-wire",
      "kind": "range_local",
      "mandatory": true,
      "proof_class": "protocol",
      "requested_capabilities": ["http11", "range"],
      "expected_outcome": "range-206-2-5"
