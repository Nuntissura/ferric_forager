      "requested_capabilities": ["cookie_scope"],
      "expected_outcome": "FF-TRANSPORT-E-COOKIE-PUBLIC-SUFFIX: cookie domain is a public suffix"
    },
    {
      "id": "cookie-control-character-rejection",
      "kind": "cookie_syntax",
      "mandatory": true,
      "proof_class": "security",
      "requested_capabilities": ["cookie_scope"],
